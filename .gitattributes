* text=auto

# Shell scripts must remain executable and use Unix line endings.
*.sh text eol=lf
.githooks/* text eol=lf

# Windows command scripts retain Windows line endings.
*.bat text eol=crlf
*.cmd text eol=crlf

# Common binary formats
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
