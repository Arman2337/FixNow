# Copy this file to .env for local development when applications are introduced.
# Never place real credentials or production values in this tracked file.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Public application URLs
BACKEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Future service configuration. Replace placeholders locally, not here.
DATABASE_URL=postgresql://fixnow:replace-me@localhost:5432/fixnow
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-local-value
OTP_SECRET=replace-with-a-separate-long-random-local-value
# Explicit local-device testing only. The backend rejects this outside development.
LOCAL_OTP_BYPASS_ENABLED=false
REALTIME_ALLOWED_ORIGINS=http://localhost:3000
# Flutter web uses this stable browser URL when started with `bun dev`.
FLUTTER_WEB_PORT=51354
LOCATION_UPDATE_INTERVAL_MS=10000
LOCATION_STALE_AFTER_MS=60000
LOCATION_CACHE_TTL_MS=60000
LOCATION_PRESENCE_TTL_MS=45000
LOCATION_CONSENT_TTL_MS=43200000
LOCATION_MAX_ACCURACY_METERS=100
LOCATION_NOTICE_VERSION=2026-08-13

# Optional SMTP delivery (for Gmail, use smtp.gmail.com and a local app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Governed AI foundation. Disabled is the safe default; no real provider is
# approved or configured. `fake` is for local development and tests only.
AI_ENABLED=false
AI_PROVIDER=disabled
AI_MODEL=not-configured
AI_TIMEOUT_MS=3000
AI_MAX_OUTPUT_TOKENS=256
AI_REQUEST_RATE_LIMIT=10
AI_REQUEST_RATE_WINDOW_MS=60000

# Governed multimodal problem classification (FN-058 voice, FN-059 image).
# Both modality kill switches default OFF. Turning them on additionally
# requires AI_ENABLED=true with a non-disabled AI_PROVIDER, and — for any live
# (non-fake) provider — the ADR-0014 release gate must be passed first. Local
# development and tests use AI_PROVIDER=fake, which never leaves the machine.
AI_VOICE_ENABLED=false
AI_VISION_ENABLED=false
# Per-request media ceilings enforced by the AI layer (bytes). Oversized
# uploads are rejected cleanly as INPUT_REJECTED, never a 500.
AI_MAX_IMAGE_BYTES=8388608
AI_MAX_AUDIO_BYTES=15728640

# Hugging Face adapter (Whisper ASR + Qwen2.5-VL). Real but gated: selected
# only when AI_PROVIDER=huggingface AFTER the ADR-0014 gate. HF_TOKEN is
# server-side ONLY — never expose it to the mobile/web client and never commit
# it. Leave AI_PROVIDER=disabled/fake and HF_TOKEN empty until then.
HF_TOKEN=
HF_INFERENCE_BASE_URL=https://router.huggingface.co/v1
HF_ASR_BASE_URL=https://api-inference.huggingface.co/models
HF_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
HF_WHISPER_MODEL=openai/whisper-large-v3


# Local-only provider document services (SeaweedFS S3 API + ClamAV).
PROVIDER_DOCUMENT_S3_ENDPOINT=http://127.0.0.1:8333
PROVIDER_DOCUMENT_S3_REGION=local
PROVIDER_DOCUMENT_S3_ACCESS_KEY=fixnow-local
PROVIDER_DOCUMENT_S3_SECRET_KEY=replace-with-local-only-secret
PROVIDER_DOCUMENT_BUCKET=fixnow-provider-documents
PROVIDER_DOCUMENT_RETENTION_DAYS=30
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Optional: OpenRouteService key for real road-route testing. Never commit a real key.
OPENROUTESERVICE_API_KEY=

# Governed push notification foundation (FN-061). `disabled` registers no
# provider; `fake` is for local development and tests only and is rejected in
# production; `fcm` requires an untracked Firebase service-account JSON file.
PUSH_PROVIDER=disabled
# Untracked local path to the Firebase service-account JSON. Never commit it.
FCM_CREDENTIALS_FILE=

# Domain notification policy (FN-062). Quiet hours are a server-wide UTC
# window "start-end" (e.g. "23-7"); empty disables the window entirely.
NOTIFICATION_QUIET_HOURS_UTC=
# Booking reminders scan upcoming scheduled bookings this many minutes ahead
# and run on the given interval. Both are optional with safe defaults.
NOTIFICATION_REMINDER_LEAD_MINUTES=60
NOTIFICATION_REMINDER_INTERVAL_MS=60000

# Payment foundation (FN-051, ADR-0016). `fake` is for local development and
# tests only and is rejected in production; `razorpay` requires test-mode keys
# from the Razorpay dashboard. Never commit real keys.
PAYMENT_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
