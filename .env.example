# Copy this file to .env for local development when applications are introduced.
# Never place real credentials or production values in this tracked file.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Public application URLs
BACKEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Future service configuration. Replace placeholders locally, not here.
DATABASE_URL=postgresql://fixnow:replace-me@localhost:5432/fixnow
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-local-value
OTP_SECRET=replace-with-a-separate-long-random-local-value

# Optional SMTP delivery (for Gmail, use smtp.gmail.com and a local app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
AI_PROVIDER_API_KEY=replace-with-local-api-key
