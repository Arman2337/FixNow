# Copy this file to .env for local development when applications are introduced.
# Never place real credentials or production values in this tracked file.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Public application URLs
BACKEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Future service configuration. Replace placeholders locally, not here.
DATABASE_URL=postgresql://fixnow:replace-me@localhost:5432/fixnow
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-local-value
OTP_SECRET=replace-with-a-separate-long-random-local-value
# Explicit local-device testing only. The backend rejects this outside development.
LOCAL_OTP_BYPASS_ENABLED=false
REALTIME_ALLOWED_ORIGINS=http://localhost:3000
LOCATION_UPDATE_INTERVAL_MS=10000
LOCATION_STALE_AFTER_MS=60000
LOCATION_CACHE_TTL_MS=60000
LOCATION_PRESENCE_TTL_MS=45000
LOCATION_CONSENT_TTL_MS=43200000
LOCATION_MAX_ACCURACY_METERS=100
LOCATION_NOTICE_VERSION=2026-08-13

# Optional SMTP delivery (for Gmail, use smtp.gmail.com and a local app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
AI_PROVIDER_API_KEY=replace-with-local-api-key

# Local-only provider document services (SeaweedFS S3 API + ClamAV).
PROVIDER_DOCUMENT_S3_ENDPOINT=http://127.0.0.1:8333
PROVIDER_DOCUMENT_S3_REGION=local
PROVIDER_DOCUMENT_S3_ACCESS_KEY=fixnow-local
PROVIDER_DOCUMENT_S3_SECRET_KEY=replace-with-local-only-secret
PROVIDER_DOCUMENT_BUCKET=fixnow-provider-documents
PROVIDER_DOCUMENT_RETENTION_DAYS=30
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Optional: OpenRouteService key for real road-route testing. Never commit a real key.
OPENROUTESERVICE_API_KEY=
