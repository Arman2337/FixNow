# Generated artifacts
artifacts/
# `reports/` holds generated HTML/JSON audits. They are gitignored because a
# report quotes the code it audited, and an audit of a secret leak quotes the
# secret verbatim.
reports/
outputs/
google-services.json
.cursor/
.gstack/
# Vendored tool and agent directories. Not project code: thousands of files from
# upstream projects, including test fixtures that deliberately contain
# credential-shaped strings. Leaving these un-ignored means `git add .` stages
# them, and `git add .` is exactly what people run.
.agents/
.claude/
.stitch_reference/
*.apk
