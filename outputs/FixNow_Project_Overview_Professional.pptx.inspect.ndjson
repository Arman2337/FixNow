{"kind":"textbox","id":"sh/6xkjqxg7","slide":5,"text":"Role-aware workflows support availability, assignment, status updates, and controlled live-location sharing during active work.","textPreview":"Role-aware workflows support availability, assignment, status updates, and controlled live-location sharing during active work.","textChars":127,"textLines":1,"bbox":[106,427,352,78]}
